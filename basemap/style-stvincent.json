{
  "version": 8,
  "name": "St Vincent (offline)",
  "sources": {
    "sv": {
      "type": "vector",
      "tiles": ["https://cdn.jsdelivr.net/gh/cma-uplink/cma-db-releases@basemap-v1/basemap/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "© OpenStreetMap"
    }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#f4f1ea" } },
    { "id": "earth", "type": "fill", "source": "sv", "source-layer": "earth", "paint": { "fill-color": "#f4f1ea" } },
    { "id": "landcover", "type": "fill", "source": "sv", "source-layer": "landcover", "paint": { "fill-color": "#d7e8c6", "fill-opacity": 0.7 } },
    { "id": "landuse", "type": "fill", "source": "sv", "source-layer": "landuse", "paint": { "fill-color": "#e7e6df", "fill-opacity": 0.5 } },
    { "id": "water", "type": "fill", "source": "sv", "source-layer": "water", "paint": { "fill-color": "#a8cdf0" } },
    { "id": "buildings", "type": "fill", "source": "sv", "source-layer": "buildings", "minzoom": 13, "paint": { "fill-color": "#e2dbd0", "fill-outline-color": "#d2c9bd" } },
    { "id": "roads-casing", "type": "line", "source": "sv", "source-layer": "roads", "minzoom": 9, "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#e4c9a0", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1.2, 14, 6, 18, 22] } },
    { "id": "roads", "type": "line", "source": "sv", "source-layer": "roads", "minzoom": 6, "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 14, 3.5, 18, 16] } },
    { "id": "boundaries", "type": "line", "source": "sv", "source-layer": "boundaries", "paint": { "line-color": "#9a86b0", "line-width": 1, "line-dasharray": [3, 2], "line-opacity": 0.6 } }
  ]
}
